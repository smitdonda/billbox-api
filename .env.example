PORT=5000

MONGO_DB_URL=mongodb+srv://user:password@cluster.mongodb.net/inventory-billing
MONGO_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_TIME=7d

# Only needed if the frontend runs on a different domain than the API
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
# CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app
